# Copy to .env for local runs (never commit .env).

EVM_RPC_URL=https://your-rpc.example
START_BLOCK=1

DATABASE_URL=postgresql://keeper:keeper@127.0.0.1:5432/keeper

# Flow Cadence relayer
FLOW_ACCESS_NODE=http://127.0.0.1:8888
FLOW_NETWORK=emulator
FLOW_PAYER_ADDRESS=0xf8d6e0586b0a20c7
FLOW_PAYER_PRIVATE_KEY=your-private-key-hex
FLOW_PAYER_KEY_ID=0
MAX_BRIDGE_FLOW_FEE=1.0
FINALIZE_POLL_INTERVAL_MS=30000
COMPOUND_POLL_INTERVAL_MS=3600000

# Deployment-specific contract overrides (required for RelayerRouter + LiquidStaking on emulator)
FLOW_CONTRACT_RELAYER_ROUTER=0x...
FLOW_CONTRACT_LIQUID_STAKING=0x...
FLOW_CONTRACT_LIQUID_STAKING_CONFIG=0x...
FLOW_CONTRACT_SFLOW_TOKEN=0x...
FLOW_CONTRACT_EVM_ROUTE=0x...
FLOW_CONTRACT_FLOW_EPOCH=0x...

# Seed script (npm run seed:contract)
VAULT_ADDRESS=0x...
CHAIN_ID=646
STARTING_BLOCK=0
